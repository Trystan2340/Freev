  "mandatoryIconPipeline": {
    "enabled": true,
    "autoProcessOnBuild": true,
    "incomingFolder": "incoming/",
    "registry": "registry/apps.json",
    "rejectIncomplete": true,
    "rejectUnregisteredMasters": true,
    "watchCommand": "npm run icons:watch",
    "launchers": [
      "START_ICON_WATCHER.bat",
      "SYNC_NEW_ICONS.bat",
      "start-icon-watcher.sh",
      "sync-new-icons.sh"
    ]
  },
  "automaticOnboarding": {
    "registry": "registry/apps.json",
    "incoming": "incoming/",
    "command": "python tools/icon_pipeline.py sync --enforce",
    "buildGate": true
  }
