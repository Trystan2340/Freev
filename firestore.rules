rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Le propriétaire Firebase peut amorcer et administrer Nova.
    // Les autres administrateurs sont déclarés dans novaAdmins/{uid}.
    function isNovaOwner() {
      return request.auth != null
        && request.auth.token.email == 'trystan.bonnin27@icloud.com'
        && request.auth.token.email_verified == true;
    }

    // Une action de maintenance exige une reconnexion datant de moins de
    // dix minutes. Cela ferme aussi la voie Firestore directe si une ancienne
    // session propriétaire est récupérée dans un navigateur compromis.
    function hasRecentAuthentication() {
      return request.auth != null
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= (request.time.toMillis() / 1000) - 600
        && request.auth.token.auth_time <= (request.time.toMillis() / 1000) + 30;
    }

    function isNovaAdmin() {
      return request.auth != null
        && (isNovaOwner()
          || (exists(/databases/$(database)/documents/novaAdmins/$(request.auth.uid))
            && get(/databases/$(database)/documents/novaAdmins/$(request.auth.uid)).data.active == true));
    }

    function hasNovaAccess(userId) {
      return isNovaAdmin()
        || (signedInAs(userId)
          && exists(/databases/$(database)/documents/novaEntitlements/$(userId))
          && get(/databases/$(database)/documents/novaEntitlements/$(userId)).data.active == true
          && get(/databases/$(database)/documents/novaEntitlements/$(userId)).data.plan == 'nova'
          && (get(/databases/$(database)/documents/novaEntitlements/$(userId)).data.expiresAt == null
            || get(/databases/$(database)/documents/novaEntitlements/$(userId)).data.expiresAt > request.time));
    }

    match /users/{userId} {
      function clientUserFields() {
        return [
          'uid', 'email', 'createdAt', 'lastLoginAt', 'updatedAt',
          'profileCompleted', 'nickname', 'nicknameLower', 'displayName',
          'avatarColor', 'bio', 'favoriteType', 'bannerTheme',
          'schemaVersion', 'avatar', 'theme', 'photo', 'publicProfile',
          'aiConfig', 'aiConfigsList', 'stats'
        ];
      }

      allow read: if signedInAs(userId) || isNovaAdmin();
      allow create: if signedInAs(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(clientUserFields());
      allow update: if signedInAs(userId)
        && resource.data.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields());
      allow delete: if false;

      match /saves/{saveId} {
        allow read, create, update, delete: if signedInAs(userId);

        match /history/{historyId} {
          allow read, create, update, delete: if signedInAs(userId);
        }
      }

      match /chatHistory/{entryId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'date', 'mode', 'model', 'question', 'response', 'savedAt'
          ])
          && request.resource.data.id == entryId
          && request.resource.data.id is string
          && request.resource.data.id.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 40
          && request.resource.data.mode is string
          && request.resource.data.mode.size() <= 20
          && request.resource.data.model is string
          && request.resource.data.model.size() <= 200
          && request.resource.data.question is string
          && request.resource.data.question.size() <= 4000
          && request.resource.data.response is string
          && request.resource.data.response.size() <= 20000;
      }

      // Mémoires choisies explicitement par l'utilisateur pour Nova.
      match /memories/{memoryId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && memoryId.matches('^[a-zA-Z0-9_-]{3,100}$')
          && request.resource.data.keys().hasOnly([
            'id', 'title', 'content', 'enabled', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == memoryId
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 80
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 4000
          && request.resource.data.enabled is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      }

      // Inventaire de sessions utile à la sécurité du compte.
      match /devices/{deviceId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && deviceId.matches('^[a-zA-Z0-9_-]{8,100}$')
          && request.resource.data.keys().hasOnly([
            'id', 'label', 'platform', 'createdAt', 'lastSeenAt'
          ])
          && request.resource.data.id == deviceId
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 80
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 80
          && request.resource.data.createdAt is timestamp
          && request.resource.data.lastSeenAt is timestamp
          && request.resource.data.lastSeenAt <= request.time + duration.value(1, 'm');
      }

      // Les badges et l'XP sont lisibles par le propriétaire mais ne pourront
      // être attribués que par un environnement serveur privilégié.
      match /achievements/{achievementId} {
        allow read: if signedInAs(userId);
        allow write: if false;
      }

      // Le navigateur peut lire uniquement le ciphertext de son propre compte.
      // Le déchiffrement est impossible sans la clé principale conservée sur Render.
      match /privateApiKeys/{secretId} {
        allow read, delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && secretId.matches('^[a-f0-9]{40}$')
          && request.resource.data.keys().hasOnly([
            'ciphertext', 'baseUrl', 'model', 'provider', 'version', 'updatedAt'
          ])
          && request.resource.data.ciphertext is string
          && request.resource.data.ciphertext.size() >= 80
          && request.resource.data.ciphertext.size() <= 15000
          && request.resource.data.baseUrl is string
          && request.resource.data.baseUrl.size() >= 8
          && request.resource.data.baseUrl.size() <= 500
          && request.resource.data.model is string
          && request.resource.data.model.size() >= 1
          && request.resource.data.model.size() <= 200
          && request.resource.data.provider is string
          && request.resource.data.provider.size() >= 3
          && request.resource.data.provider.size() <= 253
          && request.resource.data.version == 1
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm')
          && request.resource.data.updatedAt > request.time - duration.value(10, 'm');
      }

      // Profils de modèles Nova. Une clé API en clair n'est jamais un champ autorisé.
      match /novaModels/{profileId} {
        allow read, delete: if signedInAs(userId) && hasNovaAccess(userId);
        allow create, update: if signedInAs(userId)
          && hasNovaAccess(userId)
          && profileId.matches('^[a-zA-Z0-9_-]{3,80}$')
          && request.resource.data.keys().hasOnly([
            'id', 'label', 'source', 'baseUrl', 'model', 'secretId',
            'capabilities', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'label', 'source', 'baseUrl', 'model', 'secretId',
            'capabilities', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == profileId
          && request.resource.data.label is string
          && request.resource.data.label.size() >= 1
          && request.resource.data.label.size() <= 60
          && request.resource.data.source in ['local', 'api']
          && request.resource.data.baseUrl is string
          && request.resource.data.baseUrl.size() >= 8
          && request.resource.data.baseUrl.size() <= 500
          && request.resource.data.model is string
          && request.resource.data.model.size() >= 1
          && request.resource.data.model.size() <= 200
          && request.resource.data.secretId is string
          && ((request.resource.data.source == 'local'
              && request.resource.data.baseUrl.matches('^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?(/.*)?$')
              && request.resource.data.secretId == '')
            || (request.resource.data.source == 'api'
              && request.resource.data.baseUrl.matches('^https://.*$')
              && request.resource.data.secretId.matches('^[a-f0-9]{40}$')))
          && request.resource.data.capabilities is list
          && request.resource.data.capabilities.size() <= 8
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      }

      // Une affectation contient seulement des identifiants de profils, jamais des secrets.
      match /novaAssignments/{targetId} {
        allow read, delete: if signedInAs(userId) && hasNovaAccess(userId);
        allow create, update: if signedInAs(userId)
          && hasNovaAccess(userId)
          && targetId.matches('^(spark|archon|codex|buddy|axiom|forge|auditor|navigator|iris|pixel|operator|sentinel|archivist)$')
          && request.resource.data.keys().hasOnly(['targetId', 'modelIds', 'updatedAt'])
          && request.resource.data.keys().hasAll(['targetId', 'modelIds', 'updatedAt'])
          && request.resource.data.targetId == targetId
          && request.resource.data.modelIds is list
          // Les trois modes acceptent tous les profils choisis. Une créature
          // du Conseil ne peut jamais recevoir plus d'un modèle.
          && (targetId.matches('^(spark|archon|codex)$')
            || request.resource.data.modelIds.size() <= 1)
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      }

      match /novaHistory/{entryId} {
        allow read, delete: if signedInAs(userId) && hasNovaAccess(userId);
        allow create, update: if signedInAs(userId)
          && hasNovaAccess(userId)
          && request.resource.data.keys().hasOnly([
            'id', 'kind', 'target', 'prompt', 'response', 'models', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'kind', 'target', 'prompt', 'response', 'models', 'createdAt'
          ])
          && request.resource.data.id == entryId
          && request.resource.data.kind in ['mode', 'council']
          && request.resource.data.target is string
          && request.resource.data.target.size() <= 200
          && request.resource.data.prompt is string
          && request.resource.data.prompt.size() <= 6000
          && request.resource.data.response is string
          && request.resource.data.response.size() <= 30000
          && request.resource.data.models is list
          && request.resource.data.models.size() <= 20
          && request.resource.data.createdAt is timestamp;
      }
    }

    match /novaEntitlements/{userId} {
      allow get: if signedInAs(userId) || isNovaAdmin();
      allow list: if isNovaAdmin();
      allow create, update: if isNovaAdmin()
        && request.resource.data.keys().hasOnly([
          'uid', 'active', 'plan', 'expiresAt', 'grantedBy', 'grantedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'active', 'plan', 'expiresAt', 'grantedBy', 'grantedAt', 'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.active is bool
        && request.resource.data.plan == 'nova'
        && (request.resource.data.expiresAt == null
          || request.resource.data.expiresAt is timestamp)
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.grantedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      allow delete: if false;
    }

    match /novaAdmins/{userId} {
      allow read: if signedInAs(userId) || isNovaAdmin();
      allow create, update: if isNovaOwner()
        && request.resource.data.keys().hasOnly(['uid', 'active', 'createdBy', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.active == true
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow delete: if isNovaOwner();
    }

    // Configuration publique pilotée par NEXUS. Tout le monde peut lire les
    // deux documents nécessaires au site, mais seul le propriétaire vérifié
    // peut les écrire. Aucun secret ni motif interne n'est accepté ici.
    match /sitePublic/{documentId} {
      function validMaintenance() {
        return request.resource.data.keys().hasOnly([
            'enabled', 'scope', 'modules', 'publicTitle', 'publicMessage',
            'expectedBackAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'enabled', 'scope', 'modules', 'publicTitle', 'publicMessage',
            'expectedBackAt', 'updatedAt'
          ])
          && request.resource.data.enabled is bool
          && request.resource.data.scope in ['global', 'module']
          && request.resource.data.modules is list
          && request.resource.data.modules.size() <= 3
          && request.resource.data.modules.hasOnly(['games', 'ai', 'nova'])
          && (request.resource.data.scope == 'module'
            || request.resource.data.modules.size() == 0)
          && request.resource.data.publicTitle is string
          && request.resource.data.publicTitle.size() >= 5
          && request.resource.data.publicTitle.size() <= 80
          && request.resource.data.publicMessage is string
          && request.resource.data.publicMessage.size() >= 10
          && request.resource.data.publicMessage.size() <= 300
          && (request.resource.data.expectedBackAt == null
            || request.resource.data.expectedBackAt is timestamp)
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      }

      function validDesign() {
        return request.resource.data.keys().hasOnly([
            'primary', 'secondary', 'background', 'iconTheme', 'iconVariant',
            'motion', 'cardRadius', 'density', 'version', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'primary', 'secondary', 'background', 'iconTheme', 'iconVariant',
            'motion', 'cardRadius', 'density', 'version', 'updatedAt'
          ])
          && request.resource.data.primary is string
          && request.resource.data.primary.matches('^#[0-9A-F]{6}$')
          && request.resource.data.secondary is string
          && request.resource.data.secondary.matches('^#[0-9A-F]{6}$')
          && request.resource.data.background in ['midnight', 'nebula', 'graphite']
          && request.resource.data.iconTheme in [
            'cyan', 'purple', 'emerald', 'gold', 'ruby', 'rose',
            'orange', 'graphite', 'ice'
          ]
          && request.resource.data.iconVariant in [
            'standard', 'glass', 'transparent', 'monochrome-white',
            'monochrome-black', 'monochrome-brand', 'small-simplified'
          ]
          && request.resource.data.motion in ['calm', 'normal', 'dynamic']
          && request.resource.data.density in ['compact', 'comfortable']
          && request.resource.data.cardRadius is int
          && request.resource.data.cardRadius >= 12
          && request.resource.data.cardRadius <= 32
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.updatedAt <= request.time + duration.value(1, 'm');
      }

      allow get: if documentId in ['maintenance', 'design'];
      allow list: if false;
      allow create, update: if isNovaOwner()
        && ((documentId == 'maintenance' && hasRecentAuthentication() && validMaintenance())
          || (documentId == 'design' && validDesign()));
      allow delete: if false;
    }

    // Copie privée utilisée pour les motifs internes et le retour arrière.
    // Elle n'est jamais exposée à un autre compte ni aux visiteurs.
    match /siteAdmin/{documentId} {
      function validPrivateMaintenance() {
        return request.resource.data.keys().hasOnly([
            'enabled', 'scope', 'modules', 'publicTitle', 'publicMessage',
            'expectedBackAt', 'updatedAt', 'reasonInternal', 'updatedBy'
          ])
          && request.resource.data.enabled is bool
          && request.resource.data.scope in ['global', 'module']
          && request.resource.data.modules is list
          && request.resource.data.modules.size() <= 3
          && request.resource.data.modules.hasOnly(['games', 'ai', 'nova'])
          && request.resource.data.publicTitle is string
          && request.resource.data.publicTitle.size() <= 80
          && request.resource.data.publicMessage is string
          && request.resource.data.publicMessage.size() <= 300
          && request.resource.data.reasonInternal is string
          && request.resource.data.reasonInternal.size() <= 500
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }

      function validPrivateDesign() {
        return request.resource.data.keys().hasOnly([
            'primary', 'secondary', 'background', 'iconTheme', 'iconVariant',
            'motion', 'cardRadius', 'density', 'version', 'updatedAt',
            'previous', 'updatedBy'
          ])
          && request.resource.data.primary is string
          && request.resource.data.primary.matches('^#[0-9A-F]{6}$')
          && request.resource.data.secondary is string
          && request.resource.data.secondary.matches('^#[0-9A-F]{6}$')
          && request.resource.data.background in ['midnight', 'nebula', 'graphite']
          && request.resource.data.iconTheme is string
          && request.resource.data.iconVariant is string
          && request.resource.data.motion in ['calm', 'normal', 'dynamic']
          && request.resource.data.density in ['compact', 'comfortable']
          && request.resource.data.cardRadius is int
          && request.resource.data.cardRadius >= 12
          && request.resource.data.cardRadius <= 32
          && request.resource.data.version is int
          && request.resource.data.version >= 1
          && request.resource.data.previous is map
          && request.resource.data.previous.size() <= 12
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt is timestamp;
      }

      allow get: if isNovaOwner() && documentId in ['maintenance', 'design'];
      allow list: if false;
      allow create, update: if isNovaOwner()
        && ((documentId == 'maintenance' && hasRecentAuthentication() && validPrivateMaintenance())
          || (documentId == 'design' && validPrivateDesign()));
      allow delete: if false;
    }

    // Journal d'administration : le propriétaire peut créer et consulter les
    // entrées, mais personne ne peut les modifier ou les supprimer ensuite.
    match /nexusAudit/{auditId} {
      function validAuditEntry() {
        return auditId.matches('^[0-9TZ]{16,24}-[a-f0-9]{12}$')
          && request.resource.data.keys().hasOnly([
            'id', 'action', 'target', 'summary', 'actorUid', 'actorEmail',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'action', 'target', 'summary', 'actorUid', 'actorEmail',
            'createdAt'
          ])
          && request.resource.data.id == auditId
          && request.resource.data.action is string
          && request.resource.data.action.size() <= 60
          && request.resource.data.target is string
          && request.resource.data.target.size() <= 80
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 240
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorEmail == request.auth.token.email
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt <= request.time + duration.value(1, 'm');
      }

      allow get, list: if isNovaOwner();
      allow create: if isNovaOwner() && validAuditEntry();
      allow update, delete: if false;
    }

    match /usernames/{nicknameLower} {
      // La disponibilité d'un surnom est vérifiée uniquement après connexion.
      // Une liste publique exposerait les UID associés à tous les surnoms.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nicknameLower == nicknameLower;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nicknameLower == nicknameLower;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Projection publique séparée : aucun email, UID privé, secret ou mémoire.
    match /publicProfiles/{nicknameLower} {
      function ownsRegisteredNickname() {
        return request.auth != null
          && exists(/databases/$(database)/documents/usernames/$(nicknameLower))
          && get(/databases/$(database)/documents/usernames/$(nicknameLower)).data.uid == request.auth.uid;
      }

      function ownsLegacyProfile() {
        return request.auth != null
          && resource.data.keys().hasAny(['ownerUid'])
          && resource.data.ownerUid == request.auth.uid;
      }

      function hasSafePublicFields() {
        return request.resource.data.nicknameLower == nicknameLower
          && request.resource.data.keys().hasOnly([
            'nickname', 'nicknameLower', 'displayName', 'bio',
            'avatar', 'theme', 'publishedAt', 'updatedAt'
          ])
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() >= 3
          && request.resource.data.nickname.size() <= 24
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 40
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 160
          && request.resource.data.avatar is map
          && request.resource.data.theme is map
          && request.resource.data.publishedAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      // Firestore ne masque pas les champs : un ancien document contenant
      // ownerUid reste donc privé jusqu'à sa migration par son propriétaire.
      allow get: if !resource.data.keys().hasAny(['ownerUid'])
        || ownsLegacyProfile();
      allow list: if false;
      allow create: if ownsRegisteredNickname()
        && hasSafePublicFields();
      allow update: if (ownsRegisteredNickname() || ownsLegacyProfile())
        && hasSafePublicFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerUid', 'nickname', 'displayName', 'bio', 'avatar', 'theme', 'updatedAt'
        ]);
      allow delete: if ownsRegisteredNickname() || ownsLegacyProfile();
    }
  }
}
